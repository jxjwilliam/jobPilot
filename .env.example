# Copy this file to .env.local and fill in values.
# Source keys from the existing .env and/or Supabase dashboard.
# Never commit .env, .env.local, or other secret files.
#
# Map DeepSeek (or your preferred OpenAI-compatible provider) into OPENAI_COMPATIBLE_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash

BILLING_MODE=mock
EMAIL_MODE=mock
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=noreply@jobpilot.local
