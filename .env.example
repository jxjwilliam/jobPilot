# Copy this file to .env.local and fill in values.
# Source keys from the existing .env and/or Supabase dashboard.
# Never commit .env, .env.local, or other secret files.
#
# Map DeepSeek (or your preferred OpenAI-compatible provider) into OPENAI_COMPATIBLE_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash

BILLING_MODE=mock
EMAIL_MODE=mock
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=noreply@jobpilot.local

# Demo access — shows a passwordless "Try the demo" button (no email sent,
# no auth needed). Leave false unless you want public demo logins.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_EMAIL=demo@jobpilot.local

# Fixed-credential login gate (/login). The app is single-tenant: only this
# email may sign in, and the server mints the Supabase session after the
# password matches. The code falls back to the original hardcoded pair when
# these are unset — set them in your host's env so the password stays out of
# the repo.
APP_LOGIN_EMAIL=
APP_LOGIN_PASSWORD=
